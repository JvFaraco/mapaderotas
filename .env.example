# Copy to .env and adjust. Every value here has a safe default; nothing in the
# source tree hardcodes a deployment-specific string.

# Nominatim requires an identifiable client with a contact address.
GEOCODER_USER_AGENT=route-coverage-portfolio
GEOCODER_CONTACT_EMAIL=contato@example.com
# Their usage policy caps anonymous clients at 1 request/second.
GEOCODER_MIN_DELAY_SECONDS=1.1
REQUEST_TIMEOUT_SECONDS=30

# Paths. data/private/ is git-ignored and is where real inputs and the cache go.
DATA_DIR=data
CACHE_PATH=data/private/geocode_cache.json
BOUNDARIES_DIR=data/private/ibge_districts
OUTPUT_PATH=dist/route-coverage-map.html
WEB_DIR=web
